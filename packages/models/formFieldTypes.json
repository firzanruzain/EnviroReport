        "maxDate": {
          "type": "string",
          "optional": true
        },
        "format": {
          "type": "string",
          "optional": true
        }
      }
    },
    "FT_TIME": {
      "label": "Time",
      "icon": "clock",
      "defaultConfig": {
        "placeholder": "Select time",
        "validation": {
          "required": false
        }
      },
      "configSchema": {
        "format": {
          "type": "string",
